# Copier dans .env (ignore par Git), puis choisir un secret local.
DB_PASSWORD=replace-with-a-long-local-password
FRONTEND_PORT=8080

# Places : l'overlay compose.places.yml fixe l'URL et active la synchronisation.
# Choisir les identifiants ci-dessous pour utiliser cet overlay.
PLACES_API_URL=
PLACES_API_USER=
PLACES_API_PASSWORD=
# Tarifs : laisser vides tant que ses API ne sont pas disponibles.
TARIFFS_API_URL=
TARIFFS_API_USER=
TARIFFS_API_PASSWORD=
PLACES_SYNC_ENABLED=false

# Aucun delai d'absence : le creneau paye est conserve jusqu'a sa fin.

# Clients internes : noms distincts, empreintes Argon2 generees hors Git.
# L'overlay Places exige AUTH_PLACES_USER, PASSWORD et PASSWORD_HASH coherents.
# Dans un fichier .env, entourer une empreinte contenant $ par des apostrophes.
AUTH_PLACES_USER=
AUTH_PLACES_PASSWORD_HASH=
# Secret de Places pour valider les sessions ; son empreinte ci-dessus est dans Reservations.
AUTH_PLACES_PASSWORD=
AUTH_TARIFFS_USER=
AUTH_TARIFFS_PASSWORD_HASH=
AUTH_SUBSCRIPTIONS_USER=
AUTH_SUBSCRIPTIONS_PASSWORD_HASH=
