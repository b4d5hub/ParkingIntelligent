{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "parking-intelligent": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "parking",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/parking-intelligent",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "css",
            "styles": ["src/tailwind.css"],
            "assets": []
          },
          "configurations": {
            "production": {
              "optimization": {
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                }
              },
              "budgets": [
                { "type": "initial", "maximumWarning": "750kB", "maximumError": "1.5MB" }
              ],
              "outputHashing": "all"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
